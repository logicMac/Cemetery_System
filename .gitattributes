# Normalize line endings: git stores LF in the repo, checks out CRLF on Windows
* text=auto eol=crlf

# Explicitly handle common file types
*.php text eol=crlf
*.js  text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.md  text eol=crlf
*.sql text eol=crlf
*.json text eol=crlf
*.svg text eol=crlf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
